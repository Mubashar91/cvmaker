# Production uses the public origin in .env.production.
# Override it here when using another public address, then rebuild.
# Leave unset for local development.
# NEXT_PUBLIC_SITE_URL=https://www.freecvmaker.online

# Optional: the content value from Google Search Console's HTML verification tag.
# GOOGLE_SITE_VERIFICATION=

# Optional: enables the AI features (summary and bullet point improvement, the
# AI CV job match, and the cover letter draft). Put the real key in .env.local
# for local use, or in the hosting provider's server environment settings.
# Never prefix this secret with NEXT_PUBLIC_ or commit the actual key.
# OPENAI_API_KEY=

# Optional but recommended in production: a shared store for AI rate limits, so limits
# apply across every server instance. Use an Upstash Redis database (REST URL and token),
# or Vercel's Upstash/KV integration, which provides KV_REST_API_URL and KV_REST_API_TOKEN.
# Without one, each server instance keeps its own limits in memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# A private random value mixed into the hashed IP addresses used as rate-limit keys.
# RATE_LIMIT_SALT=

# Daily cap on AI requests from all visitors together (default 2000). 0 turns the cap off.
# AI_DAILY_LIMIT=2000

# Vercel Web Analytics loads only in builds made by Vercel. Set to "off" to leave it out.
# NEXT_PUBLIC_ANALYTICS=off
