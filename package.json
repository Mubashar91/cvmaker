{
  "name": "folio-free-cv-maker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/build-responsive-previews.mjs",
    "build": "next build",
    "postbuild": "node scripts/prune-unpublished.mjs && node scripts/normalize-static-export.mjs",
    "start": "node scripts/serve.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:fixtures": "tsx scripts/create-fixtures.ts",
    "test:pdf": "tsx scripts/check-pdf-output.ts",
    "test:api": "node --test tests/ai-summary-api.mjs tests/ai-job-match-api.mjs tests/ai-cover-letter-api.mjs tests/ai-bullets-api.mjs tests/ai-tailor-cv-api.mjs",
    "templates:preview": "tsx scripts/build-template-previews.ts",
    "examples:preview": "tsx scripts/build-example-previews.ts",
    "letters:preview": "tsx scripts/build-letter-previews.ts",
    "seo:assets": "tsx scripts/build-seo-assets.ts",
    "word:templates": "tsx scripts/build-word-templates.ts",
    "seo:check": "tsx scripts/check-seo.ts",
    "seo:indexnow": "node scripts/indexnow-ping.mjs",
    "guides:screenshots": "tsx scripts/capture-guide-screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "docx": "9.15.3",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pdfjs-dist": "5.7.284",
    "pdfmake": "0.2.23",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pdfmake": "0.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
